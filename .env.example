# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Google Gemini AI key
GEMINI_API=

# Neon PostgreSQL connection string
DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Optional, recommended in production. Raises the GitHub API rate limit for
# the stats lookups from 60/hour (shared per IP) to 5,000/hour. A token with
# no scopes is enough - only public data is read.
GITHUB_TOKEN=
