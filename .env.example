# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Google Gemini AI key — still needed: Gemini writes the creature
# name, description and image prompt (text generation is on the free tier).
GEMINI_API=

# Cloudflare Workers AI — draws the creature images (generateCreatureArt
# in server/ai.ts). Free tier: 10,000 neurons/day, which is roughly
# 170 images/day with the FLUX.1 schnell model.
# Create an API token with the "Workers AI" permission in the Cloudflare
# dashboard; your Account ID is shown on the Workers AI "Use REST API" page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon PostgreSQL connection string
DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=
